# Create this bucket in Hetzner Object Storage, enable versioning, and keep the
# access/secret keys in AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY. Do not put
# credentials in this file: backend configuration is copied into local plan data.
bucket = "osrs-travel-opentofu-state"
key    = "production/terraform.tfstate"
region = "fsn1"

endpoints = {
  s3 = "https://fsn1.your-objectstorage.com"
}

use_path_style              = true
use_lockfile                = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
