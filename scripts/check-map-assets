#!/usr/bin/env python3
"""Validate the pinned tile/inset pair before a planner release. Read-only."""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request


def fetch(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "collisionlab-insets/1.0"}), timeout=60) as response:
        return response.read()


def check(pin, get=fetch):
    inset = pin.get('insets')
    if inset is None:
        return
    if inset['tileVersion'] != pin['version']:
        raise ValueError('Inset pin does not match tile pin')
    base = f"{pin['base']}/insets/{inset['version']}"
    manifest = json.loads(get(f'{base}/manifest.json'))
    tile_base = f"{pin['base']}/tactical/{pin['version']}"
    tiles = json.loads(get(f'{tile_base}/manifest.json'))
    index = json.loads(get(f'{tile_base}/index.json'))
    if (manifest['schemaVersion'] != 1 or manifest['layout'] != 'explv-tms-v1'
            or manifest['version'] != inset['version'] or manifest['tileVersion'] != pin['version']
            or manifest['cacheIdx255Sha256'] != tiles['cacheIdx255Sha256']):
        raise ValueError('Incompatible map assets')
    for name in ('regions.json', 'labels.json'):
        if name not in manifest['files']:
            raise ValueError(f'Missing asset: {name}')
    decoded = {}
    for name, expected in manifest['files'].items():
        if name.startswith('/') or '..' in name.split('/'):
            raise ValueError('Invalid asset path')
        raw = get(f'{base}/{name}')
        if hashlib.sha256(raw).hexdigest() != expected:
            raise ValueError(f'Asset hash mismatch: {name}')
        decoded[name] = json.loads(raw)
    if decoded['labels.json']['catalogueSha256'] != manifest['files']['regions.json']:
        raise ValueError('Stale labels')
    required = [set() for _ in range(4)]
    for region in decoded['regions.json']['regions']:
        for x, y, w, h in region['mask']:
            for sx in range(x // 64, (x + w - 1) // 64 + 1):
                for sy in range(y // 64, (y + h - 1) // 64 + 1):
                    required[region['plane']].add(sx << 8 | sy)
    if len(manifest['planes']) != 4 or len(manifest['supplemental']) != 4:
        raise ValueError('Invalid plane coverage')
    for plane, squares in enumerate(required):
        if squares != set(manifest['planes'][plane]):
            raise ValueError('Catalogue coverage mismatch')
        supplemental = set(manifest['supplemental'][plane])
        if not supplemental <= squares:
            raise ValueError('Invalid supplemental coverage')
        supplement_index = decoded.get(f'planes/{plane}/index.json', {})
        for square in squares:
            native = f'8/{(square >> 8) - 15}/{(square & 255) - 19}.png'
            source = supplement_index if square in supplemental else index if plane == 0 else {}
            if native not in source:
                raise ValueError(f'Missing native tile on plane {plane}: {native}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--pin', type=Path, default=Path(__file__).resolve().parents[1] / 'tiles.json')
    args = parser.parse_args()
    check(json.loads(args.pin.read_text()))
    print('Pinned map assets are compatible')


if __name__ == '__main__':
    main()
