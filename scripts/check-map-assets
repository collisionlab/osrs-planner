#!/usr/bin/env python3
"""Validate the pinned tile/inset pair before a planner release. Read-only."""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request


def fetch(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "collisionlab-insets/1.0", "Origin": "https://osrs.collisionlab.world"}), timeout=60) as response:
        if response.headers.get("Access-Control-Allow-Origin") not in ("*", "https://osrs.collisionlab.world"):
            raise ValueError("Map assets are not accessible to the browser (CORS)")
        return response.read()


def check_routing(pin, get=fetch):
    """The routing layers keep their own tiles release (the one whose collision is the plugin's), which
    may be older than the map's: check the sidecar against its pin, not against the map's tiles."""
    routing = pin.get('routingLayers')
    if routing is None:
        return
    manifest = json.loads(get(f"{pin['base']}/routing-layers/{routing['version']}/manifest.json"))
    expected = {'schemaVersion': 3, 'version': routing['version'], 'tileVersion': routing['tileVersion'],
                **{key: routing[key] for key in ('collisionContentSha256', 'transportSha256', 'separatorSha256')}}
    wrong = sorted(key for key, value in expected.items() if manifest.get(key) != value)
    if manifest.get('plugin', {}).get('revision') != routing['pluginRevision']:
        wrong.append('pluginRevision')
    if wrong:
        raise ValueError(f"Routing layers {routing['version']} do not match their pin: {', '.join(wrong)}")
    if 'components.json' not in manifest.get('files', {}):
        raise ValueError('Incomplete routing manifest')


def check(pin, get=fetch):
    check_routing(pin, get)
    inset = pin.get('insets')
    if inset is None:
        return
    if inset['tileVersion'] != pin['version']:
        raise ValueError('Inset pin does not match tile pin')
    base = f"{pin['base']}/insets/{inset['version']}"
    manifest = json.loads(get(f'{base}/manifest.json'))
    if (manifest['schemaVersion'] != 2 or manifest['layout'] != 'explv-tms-v1'
            or manifest['version'] != inset['version'] or manifest['tileVersion'] != pin['version']):
        raise ValueError('Incompatible map assets')
    for name in ('regions.json', 'labels.json'):
        if name not in manifest['files']:
            raise ValueError(f'Missing asset: {name}')
    decoded = {}
    for name, expected in manifest['files'].items():
        if name.startswith('/') or '..' in name.split('/'):
            raise ValueError('Invalid asset path')
        raw = get(f'{base}/{name}')
        if hashlib.sha256(raw).hexdigest() != expected:
            raise ValueError(f'Asset hash mismatch: {name}')
        decoded[name] = json.loads(raw)
    if decoded['labels.json']['catalogueSha256'] != manifest['files']['regions.json']:
        raise ValueError('Stale labels')
    required = [set() for _ in range(4)]
    for region in decoded['regions.json']['regions']:
        for x, y, w, h in region['mask']:
            for sx in range(x // 64, (x + w - 1) // 64 + 1):
                for sy in range(y // 64, (y + h - 1) // 64 + 1):
                    required[region['plane']].add(sx << 8 | sy)
    # Insets are cut from the pinned tiles of the map's style, every plane (osrs-tiles docs/tiles.md).
    for style in pin['styles']:
        tile_base = f"{pin['base']}/{style}/{pin['version']}"
        tiles = json.loads(get(f'{tile_base}/manifest.json'))
        if len(tiles.get('planes', [])) != 4 or tiles['cacheIdx255Sha256'] != manifest['cacheIdx255Sha256']:
            raise ValueError(f'Incompatible {style} tiles')
        index = json.loads(get(f'{tile_base}/index.json'))
        for plane, squares in enumerate(required):
            for square in squares:
                native = f"{f'p{plane}/' if plane else ''}8/{(square >> 8) - 15}/{(square & 255) - 19}.png"
                if native not in index:
                    raise ValueError(f'Missing {style} tile on plane {plane}: {native}')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--pin', type=Path, default=Path(__file__).resolve().parents[1] / 'tiles.json')
    args = parser.parse_args()
    check(json.loads(args.pin.read_text()))
    print('Pinned map assets are compatible')


if __name__ == '__main__':
    main()
