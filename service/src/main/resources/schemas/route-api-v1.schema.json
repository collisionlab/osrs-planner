{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osrs.travel/schemas/route-api-v1.schema.json",
  "title": "Route API v1",
  "oneOf": [
    { "$ref": "#/$defs/routeRequest" },
    { "$ref": "#/$defs/routePlan" }
  ],
  "$defs": {
    "worldPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "plane"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 32767 },
        "y": { "type": "integer", "minimum": 0, "maximum": 32767 },
        "plane": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate"],
      "properties": {
        "placeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "coordinate": { "$ref": "#/$defs/worldPoint" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["quest", "diary", "skill", "item", "unlock"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "walkSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "costTicks", "path"],
      "properties": {
        "kind": { "const": "walk" },
        "costTicks": { "type": "integer", "minimum": 0 },
        "path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/worldPoint" } }
      }
    },
    "travelSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "transportId", "name", "from", "to", "costTicks", "requirements"],
      "properties": {
        "kind": { "enum": ["teleport", "transport"] },
        "transportId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/worldPoint" },
        "to": { "$ref": "#/$defs/worldPoint" },
        "costTicks": { "type": "integer", "minimum": 0 },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "bankSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "costTicks"],
      "properties": {
        "kind": { "const": "bank" },
        "location": { "$ref": "#/$defs/worldPoint" },
        "costTicks": { "type": "integer", "minimum": 0 }
      }
    },
    "routeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "start", "destination", "policy"],
      "properties": {
        "account": { "$ref": "account-build-v1.schema.json" },
        "start": { "$ref": "#/$defs/location" },
        "destination": { "$ref": "#/$defs/location" },
        "policy": { "$ref": "route-policy-v1.schema.json" }
      }
    },
    "routePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "reachable", "costTicks", "start", "destination", "segments", "metadata"],
      "properties": {
        "apiVersion": { "const": "v1" },
        "reachable": { "type": "boolean" },
        "costTicks": { "type": ["integer", "null"], "minimum": 0 },
        "start": { "$ref": "#/$defs/location" },
        "destination": { "$ref": "#/$defs/location" },
        "segments": {
          "type": "array",
          "items": { "oneOf": [
            { "$ref": "#/$defs/walkSegment" },
            { "$ref": "#/$defs/travelSegment" },
            { "$ref": "#/$defs/bankSegment" }
          ] }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worldDataVersion", "accountSchemaVersion", "routingEngineVersion"],
          "properties": {
            "worldDataVersion": { "type": "string", "minLength": 1 },
            "accountSchemaVersion": { "const": 1 },
            "routingEngineVersion": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
